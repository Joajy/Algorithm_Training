import java.util.*;

class Solution {
    static int n, answer = 0;
    static boolean[] vis;
    static List<Info>[] pipes;
    static class Info {
        int v, type;
        Info(int v, int type) {
            this.v = v;
            this.type = type;
        }
    }
    
    // 0: 현재 열린 파이프 타입
    // 1: 남은 반복 수
    static void rec(int type, int count) {
        if(count == 0) {
            answer = Math.max(answer, calculate());
            return;
        }
        Deque<Integer> q = new ArrayDeque<>();
        for(int i = 1; i <= n; ++i) {
            if(vis[i]) q.add(i);
        }
        List<Integer> infected = new ArrayList<>();
        while(!q.isEmpty()) {
            int cur = q.poll();
            for(Info nxt : pipes[cur]) {
                // 현재 열린 파이프가 아니면 통과 불가, 이미 감염체로 포함된 경우도 제외
                if(nxt.type != type || vis[nxt.v]) continue;
                vis[nxt.v] = true;
                q.add(nxt.v);
                infected.add(nxt.v);
            }
        }
        for(int i = 1; i <= 3; ++i) {
            rec(i, count - 1);
        }
        // 백트래킹에서 감염됨 여부 중복 제거
        for(int infect : infected) {
            vis[infect] = false;
        }
    }
    
    public int solution(int n, int infection, int[][] edges, int k) {
        input(n, infection, edges);
        for(int i = 1; i <= 3; ++i) {
            rec(i, k);
        }
        return answer;
    }
    
    static void input(int N, int infection, int[][] edges) {
        n = N;
        vis = new boolean[n + 1];
        vis[infection] = true;
        pipes = new ArrayList[n + 1];
        for(int i = 1; i <= n; ++i) {
            pipes[i] = new ArrayList<>();
        }
        for(int[] e : edges) {
            pipes[e[0]].add(new Info(e[1], e[2]));
            pipes[e[1]].add(new Info(e[0], e[2]));
        }
    }
    
    static int calculate() {
        int count = 0;
        for(int i = 1; i <= n; ++i) {
            if(vis[i]) ++count;
        }
        return count;
    }
}
