import java.io.*;
import java.util.*;

public class Main {

    static BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
    static StringBuilder sb = new StringBuilder();
    static StringTokenizer st;
    static int n, m;
    static class Info {
        int v, cost;
        public Info(int v, int cost) {
            this.v = v;
            this.cost = cost;
        }
    }
    static List<Info>[] edges;
    static boolean[] vis;

    static void input() throws IOException {
        st = new StringTokenizer(br.readLine());
        n = Integer.parseInt(st.nextToken());
        m = Integer.parseInt(st.nextToken());
        vis = new boolean[n + 1];
        edges = new ArrayList[n + 1];
        for (int i = 1; i <= n; ++i) {
            edges[i] = new ArrayList<>();
        }
        for (int i = 0; i < m; ++i) {
            st = new StringTokenizer(br.readLine());
            int a = Integer.parseInt(st.nextToken());
            int b = Integer.parseInt(st.nextToken());
            int c = Integer.parseInt(st.nextToken());
            edges[a].add(new Info(b, c));
            edges[b].add(new Info(a, c));
        }
    }

    static void solution() {
        int answer = 0;
        PriorityQueue<Info> pq = new PriorityQueue<>((o1, o2) -> {
            return Integer.compare(o2.cost, o1.cost);
        });
        pq.add(new Info(1, 0));
        while (!pq.isEmpty()) {
            Info cur = pq.poll();
            if(vis[cur.v]) continue;
            vis[cur.v] = true;
            answer += cur.cost;
            for (Info nxt : edges[cur.v]) {
                if(vis[nxt.v]) continue;
                pq.add(nxt);
            }
        }
        System.out.println(answer);
    }

    public static void main(String[] args) throws IOException {
        input();
        solution();
    }
}
