import java.io.*;
import java.util.*;

public class Main {

    static BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
    static StringBuilder sb = new StringBuilder();
    static StringTokenizer st;
    static int n, m, answer;
    static int[][] dp;
    static char[][] area;
    static final int[] dx = {0, 1, 0, -1};
    static final int[] dy = {1, 0, -1, 0};
    static class Info {
        int x, y;
        Info(int x, int y) {
            this.x = x;
            this.y = y;
        }
    }

    static void input() throws IOException {
        st = new StringTokenizer(br.readLine());
        n = Integer.parseInt(st.nextToken());
        m = Integer.parseInt(st.nextToken());
        area = new char[n][m];
        for(int i = 0; i < n; ++i) {
            String s = br.readLine();
            for(int j = 0; j < m ;++j) {
                area[i][j] = s.charAt(j);
            }
        }
        answer = 0;
    }

    static boolean checkCondition(int x, int y) {
        // 범위 벗어나거나, 혹은 해당 위치가 바다일 경우 탐색 종료
        if(x < 0 || x >= n || y < 0 || y >= m) return false;
        if(area[x][y] == 'W') return false;
        return true;
    }

    static void search(int x, int y) {
        Deque<Info> q = new ArrayDeque<>();
        q.add(new Info(x, y));
        dp = new int[n][m];
        for(int i = 0; i < n; ++i) {
            Arrays.fill(dp[i], (int) 1e9);
        }
        int maxDist = 0;
        dp[x][y] = 0;
        while(!q.isEmpty()) {
            Info cur = q.poll();
            maxDist = Math.max(maxDist, dp[cur.x][cur.y]);
            for (int dir = 0; dir < 4; ++dir) {
                int nx = cur.x + dx[dir];
                int ny = cur.y + dy[dir];
                if(!checkCondition(nx, ny)) continue;
                if(dp[cur.x][cur.y] + 1 >= dp[nx][ny]) continue;
                dp[nx][ny] = dp[cur.x][cur.y] + 1;
                q.add(new Info(nx, ny));
            }
        }
        answer = Math.max(answer, maxDist);
    }

    static void solution() {
        for (int i = 0; i < n; ++i) {
            for (int j = 0; j < m; ++j) {
                if(area[i][j] == 'W') continue;
                search(i, j);
            }
        }
        System.out.println(answer);
    }

    public static void main(String[] args) throws IOException {
        input();
        solution();
    }
}
