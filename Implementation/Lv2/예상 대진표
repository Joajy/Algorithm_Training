class Solution
{
    public int solution(int n, int a, int b) {
        // 바로 옆에있다면 즉시 종료
        if(a % 2 == 1 && a + 1 == b) return 1;
        int answer = 0;
        while(a != b) {
            a = (a + 1) / 2;
            b = (b + 1) / 2;
            n >>= 1;
            ++answer;
        }
        return answer;
    }
}
